# Copy to .env for local runs. On Render, set these in the dashboard.

ENV=development
SECRET_KEY=change-me-in-development
DATABASE_URL=sqlite+pysqlite:///skinscaddy.db
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Render: APP_BASE_URL=https://skinscaddy-api.onrender.com (used in verify links)
APP_BASE_URL=

# Optional SMTP — required on Render so activation emails actually send.
# Gmail: SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USE_TLS=true
# SMTP_PASSWORD must be a Gmail App Password (Google Account → Security →
# 2-Step Verification → App passwords). A normal Gmail password returns 535.
# Do not turn off SMTP auth to "fix" 535.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
VERIFICATION_HOURS=48

# Push (FCM). Never commit real keys. Chat/friend/challenge POSTs still
# succeed if these are empty — Android just will not get a lock-screen ping.
# Firebase Console → Project settings → Cloud Messaging:
#   FCM_SERVER_KEY = Cloud Messaging API (Legacy) server key
# HTTP v1 (recommended if Legacy is disabled). Paste the service-account JSON
# as one line. Optional FCM_PROJECT_ID if it is not inside that JSON.
FCM_SERVER_KEY=
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
