# Copy to .env and adjust. Never commit .env.

ENV=development

# Generate a long random value before deploying:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-development

# Local default: SQLite file next to this backend/ folder (no Postgres needed).
DATABASE_URL=sqlite+pysqlite:///skinscaddy.db
# Local Docker Postgres:
# DATABASE_URL=postgresql+psycopg://skinscaddy:skinscaddy@localhost:5432/skinscaddy
# Render: set DATABASE_URL, SECRET_KEY, ENV=production in the dashboard.
# Render's postgres://... URL is accepted as-is.

# JWT lifetime (default: 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated origins, or * for local development
CORS_ORIGINS=*

# Temporary view-once photos (challenge / prop)
# PHOTO_DIR=var/photos
# PHOTO_MAX_BYTES=5242880
